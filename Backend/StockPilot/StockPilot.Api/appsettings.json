{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Your_Db_Connection"
  },

  "JwtSettings": {
    "SecretKey": "SUPER_SECRET_KEY_FOR_STOCK_PILOT_APPLICATION_2026",
    "Issuer": "Stock_Pilot_App_Issuer",
    "Audience": "Stock_Pilot_App_Audience"
  },

  "RateLimiting": {
    "General": {
      "PermitLimit": 120,
      "WindowMinutes": 1
    },
    "Sensitive": {
      "PermitLimit": 3,
      "WindowMinutes" : 10
    },
    "Login": {
      "PermitLimit": 5,
      "WindowMinutes": 1
    },
    "Upload": {
      "PermitLimit": 3,
      "QueueLimit": 0
    }
  }
}
